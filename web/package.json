{
  "name": "doppel-web",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "generate": "buf generate ../proto --template buf.gen.yaml",
    "build": "pnpm run generate && vite build",
    "check": "pnpm run generate && svelte-check --fail-on-warnings && tsc -p tsconfig.node.json --noEmit",
    "test": "pnpm run generate && vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lucide/svelte": "^1.73.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
